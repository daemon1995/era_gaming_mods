ZVSE2
** Author orig.  : DracoLich
** Name          : Experience for letting go
** Name orig     : Enhancing the experience
** Name rus.     : Опыт за отпускание монстров (ориг.: Расширение опыта)
** Changes rus.  : [Algor] вынос опции, текстов и коэффициентов в отдельные файлы
**                 [Algor] разделение коэффициентов по сложности и фиксация на начало игры
**                 Переписано на ERM2: именованные переменные, функция и цикл по армии
** Options       : 878 (0 — отключено, 1 — включено, 2 — ожидается отпускание)
** Variables     : i^es_878_*^; v7909, v7924-v7926 — только для старых сохранений
** Tmp variables : именованные локальные y, z, e
** Functions     : ES_878_CountHeroCreatures
** Requires      : Era Erm Framework

!#DC(ES_878_PENDING_RELEASE) = 2;
!#DC(ES_878_LEARNING_BONUS_TABLE) = 6548056;


!?FU(OnAfterErmInstructions);          [Фиксируем коэффициент опыта на начало игры]
!!UN:P878/?(optionState:y);
!!FU&(optionState)=0:E;

!!UN:J2/?(difficulty:y);
!!VR(difficulty):+1;                   [Ключ INI: 1..5 для сложности 0..4]
!!SN:F^ReadStrFromIni^/^%(difficulty)^/^option 878^/^Data\s\option 878 - experience for letting go.ini^/?(percentText:z);
!!VRi^es_878_expPercent^:V(percentText);
!!VRi^es_878_initialized^:S(TRUE);

!?OB(OBJ_MONSTER)&999;                 [Перед встречей с нейтральным отрядом]
!!UN:P878/?(optionState:y);
!!FU&(optionState)=0:E;

!!OB998:U?i^es_878_monType^;
!!MO998:G?i^es_878_monNum^;
!!FU(ES_878_CountHeroCreatures):Pi^es_878_monType^/?i^es_878_heroMonNum^;
!!UN:P878/(ES_878_PENDING_RELEASE);


!?FU(OnBeforeBattle)&999;              [Начавшийся бой отменяет опыт за отпускание]
!!UN:P878/?(optionState:y);
!!FU&(optionState)=0:E;

!!UN:P878/(TRUE);


!$OB(OBJ_MONSTER)&999;                 [После встречи с нейтральным отрядом]
!!UN:P878/?(optionState:y);
!!FU&(optionState)<(ES_878_PENDING_RELEASE):E;

!!UN:P878/(TRUE);
!!FU(ES_878_CountHeroCreatures):Pi^es_878_monType^/?(heroMonNum:y);
!!FU&(heroMonNum)<>i^es_878_heroMonNum^:E; [Существа присоединились к герою]

!!MA:Pi^es_878_monType^/?(monHealth:y);
!!VR(experience:y):Si^es_878_monNum^ *(monHealth) *i^es_878_expPercent^ :100;
!!FU&(experience)<=0:E;

!!HE(CURRENT_HERO):S(SKILL_LEARNING)/?(learningLevel:y) X?(specType:y)/?(specSubtype:y)/d/d/d/d/d Ed/?(heroLevel:y)/1;

!!if&(learningLevel)>0;
  !!VR(learningBonusAddr:y):S(learningLevel) *4 +(ES_878_LEARNING_BONUS_TABLE);
  !!UN:C(learningBonusAddr)/(UNC_INT)/?(learningBonusBits:y);
  ; Читаем реальный бонус Обучения из таблицы игры, включая изменения модами.
  !!SN:X?(savedEventParam:y) X(learningBonusBits) X?(learningBonus:e) X(savedEventParam);
  !!VR(learningBonus):*100;
  !!VR(learningPercent:y):S(learningBonus);

  !!if&(specType)=0/(specSubtype)=(SKILL_LEARNING);
    !!VR(specPercent:y):S(heroLevel) *5 +100;
    !!VR(learningPercent):*(specPercent) :100;
  !!en;

  !!VR(learningPercent):+100;
  !!VR(experience):*(learningPercent) :100;
!!en;

!!VR(personVariant:y):R0/1/3;
!!VR(enemyVariant:y):R0/1/3;
!!VR(expVariant:y):R0/1/3;
!!SN:T^es.878.person%(personVariant)^/?(personText:z);
!!SN:T^es.878.enemy%(enemyVariant)^/?(enemyText:z);
!!SN:T^es.878.exp%(expVariant)^/?(expText:z);
!!SN:T^es.878.dlg^/?(message:z)/^person^/(personText)/^enemy^/(enemyText)/^exp^/(expText);
!!IF:Q2/(PIC_TYPE_EXPERIENCE)/(experience)/1/(message);
!!HE(CURRENT_HERO):Ed(experience);


!?FU(ES_878_CountHeroCreatures);
; Возвращает в x2 суммарное количество существ типа x1 в армии текущего героя.
!#VA(monType:x) (totalNum:x);

!!VR(totalNum):S0;
!!re (slot:y)/(ARMY_SLOT_FIRST)/(ARMY_SLOT_LAST);
  !!HE(CURRENT_HERO):C0/(slot)/?(slotType:y)/?(slotNum:y);
  !!VR(totalNum)&(slotType)=(monType):+(slotNum);
!!en;

** end
