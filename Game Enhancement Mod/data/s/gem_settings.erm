!!FU(gem_DlgReload):P^gem_sttngs.txt^;
!!DL(GEM_DLG_GEM_SETTINGS):N^gem_sttngs.txt^;
!!OW:Cd/?(clickedPlayer:y);
!!FU(gem_DlgSetColor):P(GEM_DLG_GEM_SETTINGS)/(clickedPlayer); 
!!FU(DL_FindById):P(GEM_DLG_GEM_SETTINGS)/?(dlg:y);
!!UN:C(dlg)/4/?(dlg);
!!FU(gem_DlgDefButton_AddHotkey):P30722/1/(dlg);

!!DL(GEM_DLG_GEM_SETTINGS):A0/(DLG_CMD_SET_TEXT)/^%T(gem.settings.dlg.title)^/1;


!!SN:M(optionsArray)/?(size:y);
!!re (defId:y)/(GEM_SETTINGS_FIRST_CHECKBOX_ID)/(GEM_SETTINGS_LAST_CHECKBOX_ID);

    !!VRi:S(defId:y) -(GEM_SETTINGS_FIRST_CHECKBOX_ID);
    !!VR(textId:y):Si +(GEM_SETTINGS_FIRST_NAME_ID);

    !!if&i<(size);
        !!SN:M(optionsArray)/i/?(varName:z);
        !!VR(zIndex:y):Si +1;
        !!SN:T^gem.settings.%(varName).name^/?(name:z) T^gem.settings.%(varName).hint^/?z(zIndex);

        !!VR(state:y):Si^%(varName)^ B;
        !!DL(GEM_DLG_GEM_SETTINGS):A(defId:y)/(DLG_CMD_SET_DEF_FRAME)/(state)/1 H(defId)/z(zIndex);

        !!DL(GEM_DLG_GEM_SETTINGS):A(textId:y)/(DLG_CMD_SET_TEXT)/(name)/1 H(textId)/z(zIndex);
    !!el;
        !!FU(gem_DlgItem_Show):P(textId:y)/(FALSE)/(FALSE)/(FALSE)/(dlg);
        !!FU(gem_DlgItem_Show):P(defId:y)/(FALSE)/(FALSE)/(FALSE)/(dlg);
    !!en;
!!en;

// hide (OK) bttn
!!if&(isRmc);
    *!FU(gem_DlgItem_Show):P30722/(FALSE)/(FALSE)/(FALSE)/(dlg);
!!en;

!?FU(OnCustomDialogEvent)&i^dlg_id^=(GEM_DLG_GEM_SETTINGS)/i^mouse_item^>0;

!!VR(itemId:y):Si^mouse_item^;
!!VR(itemAction:y):Si^mouse_action^;

!!if&(itemAction)=(MOUSE_LMB_RELEASED);
    !!DL(GEM_DLG_GEM_SETTINGS)&(itemId:y)=30722:C1;
!!el|(itemAction)=(MOUSE_LMB_PRESSED)/(itemAction)=(MOUSE_RMB_PRESSED);
    !!VR(optionId:y):S-1;
    !!if&(itemId:y)>=(GEM_SETTINGS_FIRST_CHECKBOX_ID)/(itemId:y)<=(GEM_SETTINGS_LAST_CHECKBOX_ID);
        !!VR(optionId:y):S(itemId:y) -(GEM_SETTINGS_FIRST_CHECKBOX_ID);
    !!el&(itemId:y)>=(GEM_SETTINGS_FIRST_NAME_ID)/(itemId:y)<=(GEM_SETTINGS_LAST_NAME_ID);
        !!VR(optionId:y):S(itemId:y) -(GEM_SETTINGS_FIRST_NAME_ID);
    !!el;
        !!FU:E;
    !!en;

    !!SN:Mi^gem_settings_array_id^/(optionId)/?(varName:z);

    !!if&(itemAction)=(MOUSE_LMB_PRESSED);
        !!SN:P^Button.wav^;
        !!VR(state:y):Si^%(varName)^ B X1;
        !!VRi^%(varName)^:S(state);
        
        !!VR(defId:y):S(optionId) + (GEM_SETTINGS_FIRST_CHECKBOX_ID);
        !!DLi^dlg_id^:A(defId)/(DLG_CMD_SET_DEF_FRAME)/(state)/1;
    !!el;
        !!SN:T^gem.settings.%(varName).rmc^/?(msg:z);
        !!IF:M0/4/(msg:z);
    !!en;
!!en;


