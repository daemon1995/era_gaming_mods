!#DC(GEM_SETTINGS_LAST_NAME_ID) = 20;

!?FU(gem_GetSettingsArray);
!#VA(result:x);
!!FU(NewStrArray):P8/?(result:x);
!!SN:V(result:x)/0/^gem_control_units^/^gem_allyHeroScreen^/^gem_enemyHeroScreen^/^gem_spellResearch^/
^gem_adventureMapObjectHints^/^gem_ignore_siege_weapon^/^gem_artifact_hints_primary_skills^/^gem_artifact_hints_combinations^;
!!SN:F^ExtendArrayLifetime^/(result);

!?FU(gem_SaveGEMSettingsToIni);
!#VA(optionsArray:x);
!!SN:M(optionsArray)/?(size:y);
!!if&(size);
    !!VR(filePath:z):S^Runtime/game_enhancement_mod.ini^;
    
    !!re i/0/(size)/1/-1;
        !!SN:M(optionsArray)/i/?(optionName:z);
        !!FU(WriteIniInts):P(filePath)/^main^/(optionName:z)/?i^%(optionName:z)^; [save battle save option only when plugin is disabled]
    !!en;
    !!FU(SaveIni):P(filePath);
!!en;

!?FU(gem_LoadGemSettingsFromIni);
!#VA(optionsArray:x);
!!SN:M(optionsArray)/?(size:y);
!!if&(size);
    !!VR(filePath:z):S^Runtime/game_enhancement_mod.ini^;
    
    !!re i/0/(size)/1/-1;
        !!SN:M(optionsArray)/i/?(optionName:z);
        !!FU(ReadIniInts):P(filePath)/^main^/(optionName:z)/?i^%(optionName:z)^/1; [save battle save option only when plugin is disabled]
    !!en;
!!en;



!?FU(gem_InitSettings);
!!SN:F^ERA_SystemOptionsExtension:RegisterErmCallbackButton^/^gem.settings.dlg^/^gem.settings.dlg.name^/^gem.settings.dlg.hint^/(gem_ShowModSettingsDlg);
!!FU(gem_GetSettingsArray):P?(optionList:y);
!!FU(gem_LoadGemSettingsFromIni):P(optionList:y);

!?FU(OnAfterLoadGame);
!!FU(gem_InitSettings):P;
!#FU(gem_InitSettings):P;



!?FU(gem_ShowModSettingsDlg);
!#VA(isRightClick:x);
!!UN:J8/1/^gem_interface.pac^;
!!FU&-1:E;

!!FU(gem_GetSettingsArray):P?(optionsArray:y);
!!VRi^gem_settings_array_id^:S(optionsArray);

!!FU(gem_Dlg_Setting_Creating):P(optionsArray)/(isRightClick);
!!DL(GEM_DLG_GEM_SETTINGS):S1;


!!OW:C?(currPlayer:y)/?(clickedPlayer:y);

!!if&(currPlayer:y)=(clickedPlayer);
    !!FU(gem_SaveGEMSettingsToIni):P(optionsArray);
!!en;


